{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromora.local/schemas/recipe-candidates-1.0.0.json",
  "title": "Chromora Recipe Candidate Dataset",
  "description": "Candidate-only recipe data. Third-party records may be source indexes with withheld settings; this is not a release package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "generated_at",
    "release_state",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date" },
    "release_state": { "const": "candidate_only_not_a_release_package" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipeCandidate" }
    }
  },
  "$defs": {
    "recipeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entry_kind",
        "record_version",
        "recipe_version",
        "brand",
        "source_type",
        "author",
        "source_url",
        "source_title",
        "license_status",
        "camera_models",
        "sensor_generations",
        "camera_compatibility_notes",
        "base_look",
        "raw_parameters",
        "source_parameter_catalog",
        "mapped_controls",
        "unsupported_controls",
        "conditions",
        "approximation_note",
        "license_evidence",
        "attribution",
        "distribution"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "entry_kind": { "enum": ["recipe_payload", "source_index"] },
        "record_version": { "type": "string", "minLength": 1 },
        "recipe_version": { "type": "string", "minLength": 1 },
        "brand": { "type": "string", "minLength": 1 },
        "source_type": {
          "enum": ["manufacturer_published", "community_creator", "chromora_original"]
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_name", "role", "contact_url"],
          "properties": {
            "display_name": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "contact_url": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "source_title": { "type": "string", "minLength": 1 },
        "license_status": {
          "enum": ["redistributable", "permission_required", "reference_only", "original_in_house"]
        },
        "camera_models": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sensor_generations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "camera_compatibility_notes": { "type": "string" },
        "base_look": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "published_modes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "raw_parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "items", "note"],
          "properties": {
            "status": { "enum": ["included", "withheld", "not_published", "not_applicable"] },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/parameter" }
            },
            "note": { "type": ["string", "null"] }
          }
        },
        "source_parameter_catalog": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mapped_controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapping" }
        },
        "unsupported_controls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "approximation_note": { "type": "string" },
        "license_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_url", "evidence_summary", "permission_grant", "permission_scope", "reviewed_at"],
          "properties": {
            "evidence_url": { "type": ["string", "null"], "format": "uri" },
            "evidence_summary": { "type": "string", "minLength": 1 },
            "permission_grant": { "type": "boolean" },
            "permission_scope": { "type": "string", "minLength": 1 },
            "reviewed_at": { "type": "string", "format": "date" }
          }
        },
        "attribution": { "type": "string", "minLength": 1 },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "payload_included", "decision_reason"],
          "properties": {
            "allowed": { "type": "boolean" },
            "payload_included": { "type": "boolean" },
            "decision_reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "value_status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "integer", "string", "boolean", "null"] },
        "unit": { "type": ["string", "null"] },
        "value_status": { "enum": ["known", "unknown", "withheld"] },
        "note": { "type": "string" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_parameter", "target_control", "value", "unit", "mapping_status", "note"],
      "properties": {
        "source_parameter": { "type": "string", "minLength": 1 },
        "target_control": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "integer", "string", "boolean", "null"] },
        "unit": { "type": ["string", "null"] },
        "mapping_status": { "enum": ["direct_candidate", "proposed_not_validated", "unmapped", "not_applicable"] },
        "note": { "type": "string" }
      }
    }
  }
}
